#!/usr/bin/env bash
# ductus repo pre-commit hook.
#
# Runs all generators unconditionally so the committed tree always has
# up-to-date generated artifacts, and stages their outputs. Per-spec staging is
# scoped to the git index (only specs already part of the commit), so untracked
# in-progress drafts are never swept in (spec 017 / tracked-specs-not-worktree).
#
# Generators run in a fixed order:
#   1. gen-configure-mcp.sh    — runtime-MCP-tool allow blocks in
#                                framework/bootstrap/configure/{claude,auggie}.md
#                                (runs before gen-claude-commands.sh so the
#                                 regenerated configure.md picks up changes)
#   2. gen-claude-commands.sh  — .claude/commands/ductus/*.md from framework/commands/
#   3. gen-help-tables.sh      — five command tables in framework/commands/help.md
#
# The two frontmatter indexes — `dependencies:` and `references:` — are then
# derived by runtime primitives rather than shell generators: `ductus
# derive-dependencies` and `ductus derive-references`, which replaced the
# shipped bash generators (spec 022, adopter-generator-promotion). An
# unreachable runtime halts the commit rather
# than skipping them: they produce derived frontmatter this commit captures, so
# a silent skip lands values the primitives would have superseded.
#
# It then runs the acceptance-criterion labelling pass over each staged spec —
# `ductus label-criteria`, the backstop for a criterion typed by hand in an
# editor (spec 013 / criterion-identifiers). That step keeps a swallowed
# failure, and the reason is blast radius rather than optionality: a missing
# AC{n} label is caught by /ductus:analyze and assigned on the next pass, so
# nothing wrong is committed, while a stale derived index is committed wrong
# data.
#
# When staged files include anything under runtime/, this hook additionally
# runs `cargo fmt --check`, `cargo clippy --all-targets --all-features
# -- -D warnings`, and `cargo test` against the runtime crate. Skip the
# cargo checks for a single commit with DUCTUS_SKIP_RUNTIME_CHECKS=1.
#
# Installation: scripts/install-hooks.sh sets `git config core.hooksPath .githooks`.

set -euo pipefail
shopt -s nullglob
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

scripts/gen-configure-mcp.sh
scripts/gen-claude-commands.sh > /dev/null
scripts/gen-help-tables.sh

# Resolve the runtime. This repo builds the binary it ships, so its own release
# build wins over anything installed: the framework repo is where the primitives
# are developed, and a `cargo install` lag would otherwise derive this repo's
# frontmatter with a binary older than the one under test.
ductus_bin=""
if [ -x runtime/target/release/ductus ]; then
  ductus_bin="runtime/target/release/ductus"
elif command -v ductus > /dev/null; then
  ductus_bin="ductus"
fi

if [ -z "$ductus_bin" ]; then
  echo "pre-commit: the ductus runtime is not reachable." >&2
  echo "  Looked for runtime/target/release/ductus, then \`ductus\` on PATH." >&2
  echo "  Build it with (cd runtime && cargo build --release), or commit with" >&2
  echo "  --no-verify to bypass this hook deliberately." >&2
  exit 1
fi

"$ductus_bin" derive-dependencies --write > /dev/null
"$ductus_bin" derive-references --write > /dev/null

# Stage any generator-produced changes to their known output paths.
git add framework/bootstrap/configure/claude.md framework/bootstrap/configure/auggie.md
git add .claude/commands/ductus/ 2>/dev/null || true
git add framework/commands/help.md
# Re-stage only spec files already part of this commit, so the derived
# `dependencies:` / `references:` rewrites are captured without sweeping in
# untracked `/specify` drafts or unstaged edits to other tracked specs
# (spec 017 / tracked-specs-not-worktree).
#
# The spec root is matched by shape — any single leading segment, then
# `NNN-slug/spec.md` — so the hook has no configured value to get wrong. This
# repo uses the default `specs`, which is exactly why a hardcoded path went
# unnoticed in the shipped hook until an adopter fixture exercised a renamed
# spec tree (Family 22).
staged_specs="$(git diff --cached --name-only \
  | { grep -E "^[^/]+/[0-9][0-9][0-9]-[^/]+/(spec|spec-and-plan)\.md\$" || true; })"

# Acceptance-criterion labelling (spec 013), swallowed per the header note.
if [ -n "$staged_specs" ]; then
  printf '%s\n' "$staged_specs" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    "$ductus_bin" label-criteria --feature "$(basename "$(dirname "$f")")" \
      > /dev/null 2>&1 || true
    git add "$f"
  done
fi

# Runtime crate verification — only when staged changes touch runtime/.
if [[ "${DUCTUS_SKIP_RUNTIME_CHECKS:-0}" != "1" ]] \
   && git diff --cached --name-only | grep -q '^runtime/'; then
  if ! command -v cargo > /dev/null; then
    echo "pre-commit: runtime/ changes staged but cargo not on PATH; skipping verification" >&2
  else
    (
      cd runtime
      cargo fmt --all -- --check
      cargo clippy --all-targets --all-features -- -D warnings
      cargo test --quiet
    )
  fi
fi

# Empty-commit guard. On 2026-07-22 a commit (b9ce6e5) landed with a tree
# identical to its parent: the six files staged before `git commit` were
# gone from the index by the time the commit was finalized, even though
# this hook's runtime-check grep had seen them staged mid-run. The root
# cause was not conclusively identified, so guard the outcome instead:
# if the index matches HEAD when the hook ends, the commit would be
# empty — abort loudly rather than let silent data loss ship. Escape
# hatch for an intentional empty commit: DUCTUS_ALLOW_EMPTY=1.
if [[ "${DUCTUS_ALLOW_EMPTY:-0}" != "1" ]] && git diff --cached --quiet; then
  echo "pre-commit: index matches HEAD — this commit would be empty." >&2
  echo "  Staged changes were lost during the hook run (or nothing was staged)." >&2
  echo "  Re-stage the files and retry. For an intentional empty commit," >&2
  echo "  re-run with DUCTUS_ALLOW_EMPTY=1." >&2
  exit 1
fi
