#!/usr/bin/env bash
# ductus repo pre-commit hook.
#
# Runs all generators on the COMMIT's staged sources, so the committed tree
# always has up-to-date generated artifacts. This repository runs several agent
# sessions in one tree, so the working tree holds other sessions' unstaged
# sources, outputs and hunks; the hook therefore never generates from, stages,
# or overwrites any of it (spec 017 / a-commit-stages-only-its-own-generated-files).
#
# How: a scratch repository under a temp dir borrows this repository's objects
# and takes a copy of the commit's index (GIT_INDEX_FILE when `git commit -a`
# or a path list made a temporary one), and checks the staged blobs out. Every
# generator, derivation, labelling pass and markdown fix below runs there, never
# on the working tree. A file the scratch run changed is written to the real
# index as a blob, if the commit may carry it:
#   - the commit already stages it (a spec, a markdown file, a hand-staged
#     output); or
#   - the commit stages a generator source (anything under framework/, or
#     scripts/gen-*) and the file is a generated output: the six paths the
#     generators write.
# Any other change is dropped, so a commit staging no generator source stages no
# generated file, and an unstaged spec's derived frontmatter is not swept in
# (spec 017 / tracked-specs-not-worktree). The working-tree copy of a written
# file is updated only when it equals the blob that was staged when the hook
# started, so another session's unstaged edit stays byte-identical, and a file
# staged in part keeps its unstaged hunks out of the commit.
#
# The runtime is resolved first, since gen-claude-commands.sh builds the Claude
# copies with its apply-manifest and is passed it as DUCTUS_BIN (spec 080). An
# unreachable runtime halts the commit before any generator runs.
#
# Generators run in a fixed order:
#   1. gen-configure-mcp.sh    — runtime-MCP-tool allow blocks in
#                                framework/bootstrap/configure/claude.md
#                                (runs before gen-claude-commands.sh so the
#                                 regenerated configure.md picks up changes)
#   2. gen-claude-commands.sh  — .claude/commands/ductus/*.md and .pi/prompts/ductus-*.md
#                                from framework/commands/, .pi/extensions/ductus.ts from
#                                the Pi bridge, and .ductus/reference/*.md from
#                                framework/reference/
#   3. gen-help-tables.sh      — five command tables in framework/commands/help.md
#
# The two frontmatter indexes — `dependencies:` and `references:` — are then
# derived by runtime primitives rather than shell generators: `ductus
# derive-dependencies` and `ductus derive-references`, which replaced the
# shipped bash generators (spec 067, adopter-generator-promotion). An
# unreachable runtime halts the commit rather
# than skipping them: they produce derived frontmatter this commit captures, so
# a silent skip lands values the primitives would have superseded.
#
# It then runs the acceptance-criterion labelling pass over each staged spec —
# `ductus label-criteria`, the backstop for a criterion typed by hand in an
# editor (spec 013 / criterion-identifiers). That step keeps a swallowed
# failure, and the reason is blast radius rather than optionality: a missing
# AC{n} label is caught by /ductus:analyze and assigned on the next pass, so
# nothing wrong is committed, while a stale derived index is committed wrong
# data.
#
# Next it normalizes staged markdown with `markdownlint-cli2 --fix`, so a
# WYSIWYG editor's table padding and emphasis rewriting do not fail the lint CI
# runs on push. A violation `--fix` cannot repair stops the commit, printing
# the violations, when this repo's own install ran and exited 1; every other
# failure, the npx fallback's included, is swallowed, so a missing or
# unfetchable npx never blocks a commit.
#
# When staged files include anything under runtime/, this hook additionally
# runs `cargo fmt --check`, `cargo clippy --all-targets --all-features
# -- -D warnings`, and `cargo test` against the runtime crate. Skip the
# cargo checks for a single commit with DUCTUS_SKIP_RUNTIME_CHECKS=1.
#
# After every write above has landed, it runs
# `ductus check-corpus-links`, which reports every relative
# markdown link under the spec root that resolves to nothing and exits non-zero
# on one (spec 067 / adopter-corpus-link-integrity). Corpus-wide rather than
# staged-scoped, because the commit that breaks a link is usually the one that
# deletes its target and the dangling referrers are not in the commit at all.
# Family 26 of /ductus:audit covers the whole repository including
# maintainer-only files; this covers the spec corpus and is what adopters get.
#
# Last, `scripts/lint-governing-size.sh` holds AGENTS.md and the constitution
# to their size ceilings, measured as staged (spec 072): a lesson added past a
# ceiling retires, merges or relocates another in the same commit.
# Unconditional — four git calls cost nothing.
#
# Installation: scripts/install-hooks.sh sets `git config core.hooksPath .githooks`.

set -euo pipefail
shopt -s nullglob
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Was anything staged when this hook STARTED? The empty-commit guard below
# needs the answer, and it can only be had here — the scratch run between this
# line and that check rewrites the index, so by then the two states the guard
# must tell apart look identical.
staged_at_entry=0
git diff --cached --quiet || staged_at_entry=1

# Resolve the runtime. This repo builds the binary it ships, so its own release
# build wins over anything installed: the framework repo is where the primitives
# are developed, and a `cargo install` lag would otherwise derive this repo's
# frontmatter, and build its Claude copies, with a binary older than the one
# under test.
ductus_bin=""
if [ -x runtime/target/release/ductus ]; then
  ductus_bin="$ROOT/runtime/target/release/ductus"
elif command -v ductus > /dev/null; then
  ductus_bin="ductus"
fi

if [ -z "$ductus_bin" ]; then
  echo "pre-commit: the ductus runtime is not reachable." >&2
  echo "  Looked for runtime/target/release/ductus, then \`ductus\` on PATH." >&2
  echo "  Build it with (cd runtime && cargo build --release), or commit with" >&2
  echo "  --no-verify to bypass this hook deliberately." >&2
  exit 1
fi

# The spec root is matched by shape — any single leading segment, then
# `NNN-slug/spec.md` — so the hook has no configured value to get wrong. This
# repo uses the default `specs`, which is exactly why a hardcoded path went
# unnoticed in the shipped hook until an adopter fixture exercised a renamed
# spec tree (Family 22).
#
# The alternation mirrors `parse_feature_dir`, and both directory forms are
# in it. Sequential: three digits, or four or more with no leading zero,
# because `create-feature` pads to a *minimum* of three and the 1000th spec
# is `1000-slug`. Branch-scoped: `{identifier}.{n}-{slug}` (spec 051), which
# a digits-only pattern rejects outright — so before this the criteria of
# every branch-scoped spec went unlabelled, silently. A hook that demanded exactly three
# would silently stop labelling that spec's criteria. This is a copy of a rule
# whose home is the runtime, and it is a copy on purpose — the hook runs before
# any binary is resolvable. Audit Family 22
# (`scripts/audit/adopter-shell-behavior.sh`) holds the *shipped* copy of this
# pattern in agreement with the runtime, by driving it against fixtures named
# `1000-thousandth` and `1234.1-staged`. It does not reach this file, which is a
# separate one, so this copy is held by a reader — keep the two alternations
# identical when either changes.
staged_names="$(git diff --cached --name-only)"
staged_specs="$(printf '%s\n' "$staged_names" \
  | { grep -E "^[^/]+/(([0-9][0-9][0-9]|[1-9][0-9][0-9][0-9]+)|[a-z0-9]+(-[a-z0-9]+)*\.[1-9][0-9]*)-[^/]+/(spec|spec-and-plan)\.md\$" || true; })"
staged_md="$(git diff --cached --name-only --diff-filter=ACM \
  | { grep -E '\.md$' || true; })"

# Does the commit stage a generator source? Everything the three generators read
# is under framework/ or is one of their own scripts.
generator_source_staged=0
if printf '%s\n' "$staged_names" | grep -qE '^(framework/|scripts/gen-)'; then
  generator_source_staged=1
fi

# The paths the generators write, one pattern per line (ERE).
generated_outputs='^framework/bootstrap/configure/claude\.md$
^\.claude/commands/ductus/
^\.pi/prompts/
^\.pi/extensions/
^\.ductus/reference/
^framework/commands/help\.md$'

# The markdown normalizer: this repo's own install when present (the checkout
# the scratch tree lacks), else npx. Only the repo's own install can stop a
# commit (below): npx's exit 1 can be a failed fetch as well as a violation.
if [ -x "$ROOT/node_modules/.bin/markdownlint-cli2" ]; then
  mdlint=("$ROOT/node_modules/.bin/markdownlint-cli2")
  mdlint_local=1
else
  mdlint=(npx markdownlint-cli2)
  mdlint_local=0
fi

# A scratch repository: its own .git (so the runtime's repository discovery
# finds a project root), this repository's objects through alternates, and a
# copy of the index this commit will use.
scratch="$(mktemp -d "${TMPDIR:-/tmp}/ductus-pre-commit.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT

real_objects="$(cd "$(git rev-parse --git-path objects)" && pwd -P)"
real_index="${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}"
orig_tree="$(git write-tree)"
head_sha="$(git rev-parse --verify -q HEAD || true)"

# Every git command and primitive aimed at the scratch repository runs with
# git's own exported variables cleared: git sets GIT_DIR (absolute in a linked
# worktree) for a hook, and either it or GIT_INDEX_FILE would aim them back at
# the real repository.
(
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
  git init -q "$scratch"
  printf '%s\n' "$real_objects" > "$scratch/.git/objects/info/alternates"
  if [ -n "$head_sha" ]; then
    git -C "$scratch" update-ref --no-deref HEAD "$head_sha"
  fi
  cp "$real_index" "$scratch/.git/index"
  git -C "$scratch" checkout-index -a -f -u
  cd "$scratch"

  scripts/gen-configure-mcp.sh
  DUCTUS_BIN="$ductus_bin" scripts/gen-claude-commands.sh > /dev/null
  scripts/gen-help-tables.sh

  "$ductus_bin" derive-dependencies --write > /dev/null
  "$ductus_bin" derive-references --write > /dev/null

  # Acceptance-criterion labelling (spec 013), swallowed per the header note.
  if [ -n "$staged_specs" ]; then
    printf '%s\n' "$staged_specs" | while IFS= read -r f; do
      [ -f "$f" ] || continue
      "$ductus_bin" label-criteria --feature "$(basename "$(dirname "$f")")" \
        > /dev/null 2>&1 || true
    done
  fi

  # Normalize markdown: what the commit stages, and what the generators changed
  # (their outputs are markdown the commit may carry). A WYSIWYG editor
  # rewrites a document's source on save — Typora re-pads every table cell and
  # rewrites *emphasis* as _emphasis_ — and this repo pins MD060 to "compact"
  # (constitution §markdown-standards); CI runs `npx markdownlint-cli2` on
  # push, so a document edited in Typora would fail a lint nobody violated on
  # purpose. `--fix` repairs exactly this class. It runs on the staged text, so
  # a file staged in part is fixed and re-staged without its unstaged hunks.
  #
  # Deliberately NOT in the shipped adopter hook: markdownlint is an npx dev
  # dependency of this repo, and an adopter's commit must not depend on a Node
  # toolchain they never asked for.
  #
  # A violation `--fix` cannot repair stops the commit, printing what the
  # linter printed, when this repo's own install ran and exited 1, its exit
  # for violations left after fixing: CI's markdownlint step (c) would fail the
  # push on it, and a commit that hid it twice let an MD028 reach `main`
  # (spec 017 task 46). It stops here, inside the scratch copy, so nothing has
  # reached the real index. Every other outcome is swallowed: the npx fallback,
  # whose exit 1 can be a failed fetch as well as a violation, and any other
  # exit of the local install, a run that failed rather than a violation found.
  # The linter is called directly, not through xargs, because xargs reports
  # every exit from 1 to 125 as 123 and so would hide which one it was.
  git add -A > /dev/null
  to_fix="$({ printf '%s\n' "$staged_md"
    git diff --cached --name-only --diff-filter=ACM "$orig_tree" \
      | { grep -E '\.md$' || true; }; } | sort -u | { grep -v '^$' || true; })"
  if [ -n "$to_fix" ]; then
    fix_files=()
    while IFS= read -r f; do fix_files+=("$f"); done <<< "$to_fix"
    mdlint_status=0
    "${mdlint[@]}" --fix "${fix_files[@]}" > "$scratch/.git/mdlint.out" 2>&1 || mdlint_status=$?
    if [ "$mdlint_local" = 1 ] && [ "$mdlint_status" = 1 ]; then
      echo "pre-commit: markdownlint found violations --fix cannot repair:" >&2
      cat "$scratch/.git/mdlint.out" >&2
      echo "  Fix them and re-stage, or commit with --no-verify to bypass this" >&2
      echo "  hook deliberately." >&2
      exit 1
    fi
  fi
  git add -A > /dev/null
  git diff --cached --raw --no-abbrev -z --no-renames "$orig_tree" > "$scratch/changes.raw"
)

# Write what the commit may carry into the real index. A change is :oldmode
# newmode oldsha newsha status NUL path NUL.
while IFS= read -r -d '' meta && IFS= read -r -d '' rel; do
  read -r _ newmode oldsha _ change <<< "${meta#:}"

  carry=0
  if printf '%s\n' "$staged_names" | grep -Fxq -- "$rel"; then
    carry=1
  elif [ "$generator_source_staged" = 1 ] \
       && printf '%s\n' "$rel" | grep -qE "$generated_outputs"; then
    carry=1
  fi
  [ "$carry" = 1 ] || continue

  work="$ROOT/$rel"
  if [ "$change" = "D" ]; then
    git update-index --force-remove -- "$rel"
    # Leave the working-tree file alone unless it is the staged blob itself.
    if [ -f "$work" ] && [ "$(git hash-object -- "$work")" = "$oldsha" ]; then
      rm -f "$work"
    fi
    continue
  fi

  # The scratch repository's blob lives in its own object store; write it to
  # this one.
  blob="$(git hash-object -w -- "$scratch/$rel")"
  git update-index --add --cacheinfo "$newmode,$blob,$rel"

  # The working-tree copy follows only when it is exactly what was staged (or
  # absent, for a new file): anything else is another session's edit.
  if [ "$change" = "A" ]; then
    if [ ! -e "$work" ]; then
      mkdir -p "$(dirname "$work")"
      cp "$scratch/$rel" "$work"
    fi
  elif [ -f "$work" ] && [ "$(git hash-object -- "$work")" = "$oldsha" ]; then
    cp "$scratch/$rel" "$work"
  fi
done < "$scratch/changes.raw"

# Runtime crate verification — only when staged changes touch runtime/.
if [[ "${DUCTUS_SKIP_RUNTIME_CHECKS:-0}" != "1" ]] \
   && git diff --cached --name-only | grep -q '^runtime/'; then
  if ! command -v cargo > /dev/null; then
    echo "pre-commit: runtime/ changes staged but cargo not on PATH; skipping verification" >&2
  else
    (
      cd runtime
      cargo fmt --all -- --check
      cargo clippy --all-targets --all-features -- -D warnings
      cargo test --quiet
    )
  fi
fi

# Empty-commit guard. On 2026-07-22 a commit (b9ce6e5) landed with a tree
# identical to its parent: the six files staged before `git commit` were
# gone from the index by the time the commit was finalized, even though
# this hook's runtime-check grep had seen them staged mid-run. The root
# cause was not conclusively identified, so guard the outcome instead:
# staged changes that VANISH during the hook run are data loss — abort
# loudly rather than let it ship.
#
# The guard is `staged at entry AND empty at exit`, not `empty at exit`.
# The original form proxied the defect by its outcome, which made it fire on
# a state that is not the defect at all: `git commit --amend` with only a
# message change starts with an empty index legitimately, and the hook
# refused it with "staged changes were lost during the hook run" — a
# diagnosis that was simply false, for a commit that was correct. That was
# met on 2026-09-05 and worked around with --no-verify, which is the wrong
# habit for a guard against silent data loss to be teaching.
#
# Comparing entry to exit tests what the guard is actually about: something
# was staged, and now it is not. An amend with nothing staged never enters
# the window, and a genuinely empty `git commit` is refused by git itself
# before the hook runs. DUCTUS_ALLOW_EMPTY=1 remains the escape hatch.
if [[ "${DUCTUS_ALLOW_EMPTY:-0}" != "1" ]] \
   && [[ "$staged_at_entry" == "1" ]] \
   && git diff --cached --quiet; then
  echo "pre-commit: changes were staged when this hook started and the index" >&2
  echo "  now matches HEAD — the staged changes were lost during the hook run." >&2
  echo "  Re-stage the files and retry. For an intentional empty commit," >&2
  echo "  re-run with DUCTUS_ALLOW_EMPTY=1." >&2
  exit 1
fi

# Dangling spec-to-spec pointers, checked after every write above has
# landed and been staged. Blocking, for the same reason the cycle check inside
# derive-dependencies is: a staged edit can break something that is not staged,
# so a staged-only scope would miss the case it exists for. It runs after the
# staging block, as the size check below does, because each is read-only: a
# blocking read before the staging block would abort the commit with the
# derived rewrites unstaged, so a blocked commit and a passing one would leave
# the tree in different states.
# stdout is the JSON result and is discarded; the citations and fix guidance go
# to stderr. `git commit --no-verify` is the deliberate bypass.
"$ductus_bin" check-corpus-links > /dev/null

# The governing documents' size ceilings (spec 072), against the staged blobs.
scripts/lint-governing-size.sh
