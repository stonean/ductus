# Claude Code local settings (keep commands tracked for project-wide access)
.claude/*
!.claude/commands/

# ductus session state — per-user, ephemeral; managed by /ductus:target.
# Anchored to the repo root (leading `/`) so the fixtures' session files
# at `runtime/tests/fixtures/*/` (legacy root `.govern.session.toml` and
# the directory layouts) stay tracked — they're walker-context seeds, not
# per-user state.
/.ductus/session.toml

# ductus runtime pointer — resolves to this repo's own build via
# [runtime] path. Per-contributor and per-machine; regenerated by /ductus.
/.ductus/bin/
