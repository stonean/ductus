# Claude Code local settings (keep commands tracked for project-wide access)
.claude/*
!.claude/commands/

# Pi local scaffolding (keep the prompt templates and the bridge tracked for
# project-wide access, mirroring the .claude/ convention). Everything else
# under .pi/ — settings, themes, session state — is per-contributor and
# re-scaffolded by /ductus.
.pi/*
!.pi/prompts/
!.pi/extensions/

# ductus session state — per-user, ephemeral; managed by /ductus:target.
# Anchored to the repo root (leading `/`) so the fixtures' session files
# at `runtime/tests/fixtures/*/` (legacy root `.govern.session.toml` and
# the directory layouts) stay tracked — they're walker-context seeds, not
# per-user state.
/.ductus/session.toml

# ductus per-process session targets (spec 062) — one file per agent process
# with a session identity. Per-user and ephemeral; the directory also ignores
# itself, so this entry is the belt to that pair of braces.
/.ductus/sessions/

# ductus runtime pointer — resolves to this repo's own build via
# [runtime] path. Per-contributor and per-machine; regenerated by /ductus.
/.ductus/bin/

# Lint tooling installed from package.json (`npm ci`). The manifest and its
# lockfile are tracked so the markdownlint-cli2 requirement and its version
# are recorded; the install itself is per-machine. Duplicated here rather
# than relying on a contributor's global ignore, which not everyone has.
node_modules/
