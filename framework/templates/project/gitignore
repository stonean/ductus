# Environment and secrets
.env
.env.*

# Claude Code local settings (keep commands tracked for project-wide access)
.claude/*
!.claude/commands/

# Auggie local settings (keep commands tracked for project-wide access)
.augment/*
!.augment/commands/

# Antigravity local settings (keep skills tracked for project-wide access)
.agents/*
!.agents/skills/

# OpenCode local settings — command tree regenerated by /ductus; root opencode.json stays tracked
.opencode/

# Pi local settings — the prompt templates and the extension bridge are regenerated by /ductus
.pi/

# ductus derived views — non-markdown caches and indexes generated from specs.
# Markdown artifacts (specs, plans, scenarios) stay in git as the source of truth;
# binary or machine-only views regenerated from them do not. See constitution
# §text-first-artifacts.
.ductus-cache/
*.sqlite
*.sqlite-journal

# ductus session state — per-user, ephemeral; managed by the target command.
# Anchored to the session file only, so the committed .ductus/config.toml
# beside it stays tracked.
/.ductus/session.toml

# ductus per-process session targets — one file per agent process that has a
# session identity (DUCTUS_SESSION, or the agent's own session id). Per-user
# and ephemeral, like the session file; the directory also ignores itself.
/.ductus/sessions/

# ductus runtime pointer — per-contributor, per-machine; resolves to the
# store in the user's home directory. Regenerated by /ductus on any checkout
# that does not have it, so it never needs to arrive with a clone.
/.ductus/bin/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
