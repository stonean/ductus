#!/usr/bin/env bash
# Project pre-push hook. Edit this file freely — /ductus does not overwrite it
# after the initial install. Add your project's pre-push checks above or below
# the ductus hook invocation below. Git gives the refs being pushed on stdin,
# which the ductus hook reads: a check of your own that reads stdin too must
# save it first and hand the ductus hook a copy.

set -euo pipefail
# The ductus hook sits beside this file. Found from here rather than from the
# repository root, so it is found when the project is a subdirectory of its
# repository too.
hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$(git rev-parse --show-toplevel)"

# Reports the code this push carries that no committed review covers. /ductus
# updates this script on every run; do not edit it.
"$hooks_dir/ductus-pre-push" "$@"
