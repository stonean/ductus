#!/usr/bin/env bash
# managed-by: ductus
#
# Adopter pre-commit hook installed by /ductus.
#
# Runs adopter-relevant generators on every commit and stages their outputs.
# Both run with --staged: only specs that are part of this commit are rewritten,
# so committing one spec never dirties or restages the derived frontmatter of
# unrelated specs. Currently runs:
#   1. .ductus/scripts/gen-spec-deps.sh — frontmatter `dependencies:` from body
#                                         inline links to sibling specs (also
#                                         runs the dependency-cycle check, which
#                                         spans the full spec graph)
#   2. .ductus/scripts/gen-cross-service-refs.sh — frontmatter `references:` from body
#                                         inline links to other services' specs
#                                         (distinct from dependencies)
#
# It then runs the acceptance-criterion labelling pass over each staged spec —
# `ductus label-criteria`, which assigns the stable `AC{n}:` label a criterion is
# cited by and maintains the `next-criterion` counter (spec 013). This is the
# backstop for a criterion typed by hand in an editor rather than through a
# ductus command. Unlike the generators above it is a runtime primitive rather
# than a bash script, so it runs only when the runtime is reachable and its
# failure never blocks a commit: the runtime is not a prerequisite for any
# pipeline gate, and a binary predating `label-criteria` exits non-zero on the
# unknown subcommand.
#
# This file is overwritten by /ductus unless listed in .ductus/config.toml `pinned.files`.
# The `# managed-by: ductus` sentinel above is how /ductus detects that the file
# is one it owns.

set -euo pipefail
shopt -s nullglob
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

.ductus/scripts/gen-spec-deps.sh --staged
.ductus/scripts/gen-cross-service-refs.sh --staged

# Scope to the project's configured spec root (spec 040), resolved the same way
# the generators above resolve it. A hardcoded `specs` silently matches nothing
# for a project that renamed its spec tree, which leaves every rewrite below
# unstaged: the generators still fix the file on disk, but the commit captures
# the superseded frontmatter. `specs_root_of` validates the name against
# [A-Za-z0-9_-], so it is safe both as a path and interpolated into the regex.
. .ductus/scripts/lib/specs-root.sh
SPECS_ROOT="$(resolve_specs_root)"

# Re-stage only spec files already part of this commit, so the derived
# `dependencies:` / `references:` rewrites are captured without sweeping in
# untracked `/specify` drafts or unstaged edits to other tracked specs
# (spec 017 / tracked-specs-not-worktree).
staged_specs="$(git diff --cached --name-only -- "$SPECS_ROOT" \
  | { grep -E "^$SPECS_ROOT/[0-9][0-9][0-9]-[^/]+/(spec|spec-and-plan)\.md\$" || true; })"

# Resolve the runtime the way /ductus actually registers it: the repo-relative
# pointer `.ductus/bin/ductus`, which every run materializes and which resolves
# to the ductus-owned store (or to a project's own `[runtime] path`). PATH is a
# fallback for a hand-installed binary only. Since spec 048 moved the runtime
# into the store, /ductus never puts `ductus` on PATH — so a PATH-only guard is
# false for every adopter and skips this step silently on all of them, which is
# a check that cannot run wearing the costume of one that passed.
ductus_bin=""
if [ -x .ductus/bin/ductus ]; then
  ductus_bin=".ductus/bin/ductus"
elif command -v ductus > /dev/null; then
  ductus_bin="ductus"
fi

if [ -n "$staged_specs" ]; then
  printf '%s\n' "$staged_specs" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    if [ -n "$ductus_bin" ]; then
      "$ductus_bin" label-criteria --feature "$(basename "$(dirname "$f")")" \
        > /dev/null 2>&1 || true
    fi
    git add "$f"
  done
fi
